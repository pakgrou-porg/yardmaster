#
# Example yardmaster.toml. Either:
#   - paste + edit it in the Console (Config tab), which saves it to the data
#     volume, or
#   - bind-mount it read-only at /config/yardmaster.toml on the `yardmaster`
#     service (uncomment the mount in the stack).
#
# Local + LAN engines need no API key. OpenRouter is the only keyed provider;
# its key comes from the OPENROUTER_API_KEY environment variable (passed into the
# `yardmaster` service by the stack) and is NEVER written to this file.
#
# Routing stays local by default: `[routes.default]` sends everything to the
# local engine. The OpenRouter models are reached only when a request names one
# of their slugs (zero-config pass-through by model name).

schema_version = 1

[ingress]
ollama_port = 11434
openai_port = 1234
anthropic_port = 4000

[placement]
policy = "pair_default"

[egress]
# allow_remote must be true for the OpenRouter targets below to load. It does
# NOT change default routing — that is still `[routes.default]` -> local.
allow_remote = true
allow_lan = true

[discovery]
lan_scan = false

[metrics]
retention_days = 30
prometheus = true

[targets]

# ------------------------------------------------------------------- hardware
# ADR-0029. Where engines physically run. Optional and informational, except
# that it powers placement in /v1/capabilities, the Console's Capabilities
# tab, and the x-yardmaster-nodes response header. `fabric` names a dedicated
# interconnect between nodes (informational unless an engine spans them).
[nodes.strix]
accelerator = "strix_halo"   # Radeon 8060S, ROCm; also the desktop (Claude Desktop etc.)
memory_gb = 128

[nodes.gb10_a]
accelerator = "gb10"
memory_gb = 128
fabric = "qsfp"              # direct QSFP link to gb10_b

[nodes.gb10_b]
accelerator = "gb10"
memory_gb = 128
fabric = "qsfp"

# ------------------------------------------------------------------ local Ollama
# The engine itself (127.0.0.1:11434 in the shared namespace), not the :11435 proxy.
[providers.local_ollama]
kind = "openai_compatible"
base_url = "http://127.0.0.1:11434"
nodes = ["strix"]

[targets.local_llama32]
id = "llama3.2:latest"
locality = "lan"
provider = "local_ollama"

[targets.local_r1_32b]
id = "deepseek-r1:32b"
locality = "lan"
provider = "local_ollama"

# ------------------------------------------------------------- GB10 vLLM nodes
# Private-range hosts, plain http, no key. Adjust addresses / model ids to match
# `curl http://<host>:<port>/v1/models` on each box.
#
# One vLLM server per GB10 for models that fit in 128 GB:
[providers.gb10_a_vllm]
kind = "openai_compatible"
base_url = "http://10.116.2.56:8000/v1"
nodes = ["gb10_a"]

[providers.gb10_b_vllm]
kind = "openai_compatible"
base_url = "http://10.116.2.120:8000/v1"
nodes = ["gb10_b"]

# The same model id on both GB10s is a *replica*: requests go to the first one
# declared and fail over to the other if it is down, busy (429/503) or errors.
[targets.gb10_a_qwen_a3b]
id = "qwen3.6-35b-a3b"
locality = "lan"
provider = "gb10_a_vllm"

[targets.gb10_b_qwen_a3b]
id = "qwen3.6-35b-a3b"
locality = "lan"
provider = "gb10_b_vllm"

[targets.gb10_b_gemma_utility]
id = "gemma-4-12b-utility"
locality = "lan"
provider = "gb10_b_vllm"

# Each GB10 runs its own models; nothing is sharded across the QSFP link. To
# span one engine across both later, give a provider nodes = ["gb10_a", "gb10_b"].

# ------------------------------------------------------------------- OpenRouter
# Cloud fallback. Keyed via env (OPENROUTER_API_KEY). Reached only when a request
# explicitly names one of these model ids.
[providers.openrouter]
kind = "openrouter"
api_key_env = "OPENROUTER_API_KEY"

[targets.or_gpt56_terra]
id = "openai/gpt-5.6-terra"
locality = "remote"
provider = "openrouter"

[targets.or_gpt6_astra]
id = "openai/gpt-6-astra"
locality = "remote"
provider = "openrouter"

[targets.or_qwen38_max]
id = "qwen/qwen3.8-max-0902"
locality = "remote"
provider = "openrouter"

[targets.or_deepseek_v4_flash_vision]
id = "deepseek/deepseek-v4-flash-vision-exp"
locality = "remote"
provider = "openrouter"

[targets.or_qwen38_flash]
id = "qwen/qwen3.8-flash"
locality = "remote"
provider = "openrouter"

[targets.or_claude_sonnet5]
id = "anthropic/claude-sonnet-5"
locality = "remote"
provider = "openrouter"

# ----------------------------------------------------------------------- routes
[routes.default]
id = "auto"
type = "passthrough"
target = "local_r1_32b"

# Optional: local -> cloud escalation instead of pass-through. Swap the default
# route's type to "escalation" and set the targets:
# [routes.default]
# id = "auto"
# type = "escalation"
# weak_target = "local_llama32"
# strong_target = "or_claude_sonnet5"

# --------------------------------------------------------------- DeepSeek Harness
# The Harness's model list is discovered automatically from the [targets.*]
# above (ADR-0028) — nothing required here. [harness] only lets you steer it:
#
# [harness]
# default_model = "local_r1_32b"        # else falls back to [routes.default].target
#
# [harness.policy]
# deny_glob = ["*:free", "*-preview*"]  # never offer these ids to the agent
# min_context_window = 4096             # hide anything smaller (when known)
# rank_by_locality = { cluster = 0, lan = 10, remote = 20 }   # preference order
# smoke_test = false                    # opt-in (ADR-0028 P3): a real chat-completions
#                                        # POST per candidate model, not just a /v1/models
#                                        # listing check — costs real money on paid
#                                        # providers, so it's off unless you turn it on.
# smoke_test_interval_s = 3600          # re-test at most this often per model
# require_approval = false              # opt-in (ADR-0028 P4): curate instead of
#                                        # auto-include — a model only ever goes live
#                                        # (dsh, and the router's own /v1/models) once
#                                        # you Approve it in the Console's Capabilities
#                                        # tab (or set overrides."<id>".approved = true
#                                        # here by hand). Off by default: newly
#                                        # discovered/validated models are included
#                                        # automatically, the pre-P4 behavior. Turning
#                                        # this on does NOT immediately pull your
#                                        # current model list out from under dsh — an
#                                        # un-opined-on id just holds its removal
#                                        # pending, same as any other destructive
#                                        # change — but click "Approve all currently
#                                        # live" once in the Console right after
#                                        # flipping this on to clear that queue in one
#                                        # step instead of approving each by hand.
#
# [harness.overrides."qwen/qwen3.8-flash"]
# enabled = true                        # wins over policy.deny_glob for this id
# rank = 1                              # more preferred than the locality default
# default = false                       # set true to force it as the default model
# approved = true                       # only needed if [harness.policy] require_approval
#                                        # is on; true admits it, false rejects it,
#                                        # absent leaves it "pending" (never rendered)

