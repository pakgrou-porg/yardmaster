#
# Copy to .env next to the stack, or paste into Portainer's stack "Environment
# variables". Every value has a default; nothing here is required.

# ---- LAN exposure (default: loopback only) ----
YM_BIND=127.0.0.1                 # set 0.0.0.0 to reach the Console + Harness from the LAN
YM_LAN_HOST=                      # e.g. 10.116.2.145 — added to dsh's --trusted-host
YM_LAN_HOSTNAME=                  # e.g. framework — a DNS/mDNS hostname, if you browse by
                                   # name instead of IP. Without this, browsing by hostname
                                   # loads the Harness page but its UI shows "Disconnected"
                                   # (dsh's Host/Origin fence 403s every /api call for an
                                   # authority not on the --trusted-host list).

# ---- admin login (protects BOTH the Console and the Harness) ----
# Leave these empty to do a one-time setup in the browser (recommended: the
# password is entered once and stored as a scrypt hash on the data volume).
# Set them to pre-seed the credential from here instead.
YM_AUTH_USER=
YM_AUTH_PASS=
# YM_AUTH_PASS_FILE=/run/secrets/ym_auth_pass   # read the password from a file
# YM_AUTH_DISABLED=1                            # turn auth OFF — loopback dev only

# ---- DeepSeek Harness ----
YM_HARNESS_DEFAULT_MODEL=deepseek-r1:32b  # fallback for [harness].default_model in yardmaster.toml
BRAVE_API_KEY=                    # enables the Brave Search MCP server (see the deployment doc,
                                 # "Adding tools to the Harness"). Empty = no Brave tools.

# ---- providers ----
# Used by the OpenRouter targets in yardmaster.toml. Never written to the file.
OPENROUTER_API_KEY=
# Local Ollama and LAN vLLM nodes need no key.

# ---- broker ----
NVPAIR_LOG_LEVEL=info             # debug | info | warn | error
