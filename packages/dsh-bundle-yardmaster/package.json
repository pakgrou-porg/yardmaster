{
  "name": "@pakgrou-porg/dsh-bundle-yardmaster",
  "version": "0.1.0",
  "description": "DeepSeek Harness bundle: mounts dsh-yardmaster and makes the yardmaster adapter the default model adapter. Ships the yardmaster-web and yardmaster-headless profile templates.",
  "license": "Apache-2.0",
  "author": "Karl Miller",
  "repository": {
    "type": "git",
    "url": "https://github.com/pakgrou-porg/yardmaster",
    "directory": "packages/dsh-bundle-yardmaster"
  },
  "keywords": ["dsh-plugin", "dsh-bundle", "cordis", "yardmaster"],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "cordis.patch.yml",
    "profiles",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.2-rc.1 <0.2.0",
    "@pakgrou-porg/dsh-yardmaster": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.1.2-rc.1",
    "@pakgrou-porg/dsh-yardmaster": "workspace:*",
    "js-yaml": "^4.1.0",
    "typescript": "^7.0.2",
    "vitest": "^2.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
